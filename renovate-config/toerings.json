{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "github>ChrisLauinger77/ChrisLauinger77//renovate-config/default"
    ],
    "packageRules": [
        {
            "description": "Group compatible frontend dependency updates",
            "matchManagers": [
                "npm"
            ],
            "matchPackageNames": [
                "!@tauri-apps/**"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "groupName": "Frontend compatible updates"
        },
        {
            "description": "Keep ESLint and its plugins/configs together",
            "matchManagers": [
                "npm"
            ],
            "matchPackageNames": [
                "@eslint/js",
                "@typescript-eslint/eslint-plugin",
                "@typescript-eslint/parser",
                "eslint",
                "eslint-config-prettier",
                "eslint-plugin-import-x",
                "eslint-plugin-svelte",
                "globals"
            ],
            "groupName": "ESLint"
        },
        {
            "description": "Keep the Svelte/Vite/TypeScript toolchain together so peer dependencies stay compatible",
            "matchManagers": [
                "npm"
            ],
            "matchPackageNames": [
                "@sveltejs/vite-plugin-svelte",
                "@tsconfig/svelte",
                "prettier",
                "prettier-plugin-svelte",
                "svelte",
                "svelte-awesome-color-picker",
                "svelte-check",
                "svelte-preprocess",
                "typescript",
                "vite"
            ],
            "groupName": "Svelte toolchain"
        },
        {
            "description": "Group compatible Rust updates for stable versions",
            "matchManagers": [
                "cargo"
            ],
            "matchPackageNames": [
                "!tauri",
                "!tauri-build"
            ],
            "matchCurrentVersion": ">=1.0.0",
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "groupName": "Rust compatible updates"
        },
        {
            "description": "Group Rust 0.x patch updates behind dashboard approval",
            "matchManagers": [
                "cargo"
            ],
            "matchCurrentVersion": "<1.0.0",
            "matchUpdateTypes": [
                "patch"
            ],
            "groupName": "Rust 0.x patch updates",
            "dependencyDashboardApproval": true
        },
        {
            "description": "Review potentially breaking Rust 0.x minor updates individually",
            "matchManagers": [
                "cargo"
            ],
            "matchCurrentVersion": "<1.0.0",
            "matchUpdateTypes": [
                "minor"
            ],
            "groupName": null,
            "dependencyDashboardApproval": true
        },
        {
            "description": "Keep Tauri JS and Rust packages on matching versions and require dashboard approval",
            "matchPackageNames": [
                "@tauri-apps/**",
                "tauri",
                "tauri-build"
            ],
            "groupName": "Tauri",
            "dependencyDashboardApproval": true
        },
        {
            "description": "Require approval for Tauri action and Rust toolchain updates",
            "matchPackageNames": [
                "tauri-apps/tauri-action",
                "dtolnay/rust-toolchain"
            ],
            "dependencyDashboardApproval": true
        }
    ]
}

{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "local>ChrisLauinger77/ChrisLauinger77//renovate-config/default",
        "helpers:pinGitHubActionDigests"
    ],
    "packageRules": [
        {
            "description": "Group compatible frontend dependency updates",
            "matchManagers": [
                "npm"
            ],
            "matchPackageNames": [
                "!@tauri-apps/**"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "groupName": "Frontend compatible updates"
        },
        {
            "description": "Group the ESLint 10 flat-config migration and its TypeScript and Svelte integrations",
            "matchManagers": [
                "npm"
            ],
            "matchPackageNames": [
                "@typescript-eslint/eslint-plugin",
                "@typescript-eslint/parser",
                "eslint",
                "eslint-plugin-svelte"
            ],
            "groupName": "ESLint migration"
        },
        {
            "description": "Group the Svelte 5 toolchain migration to keep peer dependencies compatible",
            "matchManagers": [
                "npm"
            ],
            "matchPackageNames": [
                "@sveltejs/vite-plugin-svelte",
                "@tsconfig/svelte",
                "prettier",
                "prettier-plugin-svelte",
                "svelte",
                "svelte-awesome-color-picker",
                "svelte-check",
                "svelte-preprocess",
                "typescript",
                "vite"
            ],
            "groupName": "Svelte 5 migration"
        },
        {
            "description": "Group compatible Rust updates for stable versions",
            "matchManagers": [
                "cargo"
            ],
            "matchPackageNames": [
                "!tauri",
                "!tauri-build"
            ],
            "matchCurrentVersion": ">=1.0.0",
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "groupName": "Rust compatible updates"
        },
        {
            "description": "Group Rust 0.x patch updates behind dashboard approval",
            "matchManagers": [
                "cargo"
            ],
            "matchCurrentVersion": "<1.0.0",
            "matchUpdateTypes": [
                "patch"
            ],
            "groupName": "Rust 0.x patch updates",
            "dependencyDashboardApproval": true
        },
        {
            "description": "Require approval for Tauri and Rust toolchain updates",
            "matchPackageNames": [
                "@tauri-apps/api",
                "@tauri-apps/cli",
                "tauri",
                "tauri-build",
                "tauri-apps/tauri-action",
                "dtolnay/rust-toolchain"
            ],
            "dependencyDashboardApproval": true
        }
    ]
}

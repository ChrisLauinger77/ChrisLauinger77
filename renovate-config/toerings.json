{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "local>ChrisLauinger77/ChrisLauinger77//renovate-config/default",
        "helpers:pinGitHubActionDigests"
    ],
    "packageRules": [
        {
            "description": "Group Prettier, its Svelte plugin, and the Svelte major migration to keep peer dependencies compatible",
            "matchManagers": [
                "npm"
            ],
            "matchPackageNames": [
                "prettier",
                "prettier-plugin-svelte",
                "svelte"
            ],
            "groupName": "Prettier and Svelte"
        },
        {
            "description": "Group compatible frontend dependency updates",
            "matchManagers": [
                "npm"
            ],
            "matchPackageNames": [
                "!@tauri-apps/**"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "groupName": "Frontend compatible updates"
        },
        {
            "description": "Group compatible Rust updates for stable versions",
            "matchManagers": [
                "cargo"
            ],
            "matchPackageNames": [
                "!tauri",
                "!tauri-build"
            ],
            "matchCurrentVersion": ">=1.0.0",
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "groupName": "Rust compatible updates"
        },
        {
            "description": "Group Rust 0.x patch updates behind dashboard approval",
            "matchManagers": [
                "cargo"
            ],
            "matchCurrentVersion": "<1.0.0",
            "matchUpdateTypes": [
                "patch"
            ],
            "groupName": "Rust 0.x patch updates",
            "dependencyDashboardApproval": true
        },
        {
            "description": "Require approval for Tauri and Rust toolchain updates",
            "matchPackageNames": [
                "@tauri-apps/api",
                "@tauri-apps/cli",
                "tauri",
                "tauri-build",
                "tauri-apps/tauri-action",
                "dtolnay/rust-toolchain"
            ],
            "dependencyDashboardApproval": true
        }
    ]
}

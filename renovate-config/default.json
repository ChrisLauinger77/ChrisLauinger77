{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "assignees": [
    "ChrisLauinger77"
  ],
  "reviewers": [
    "ChrisLauinger77"
  ],
  "dependencyDashboard": true,
  "prConcurrentLimit": 3,
  "schedule": [
    "* * 8-14 * 6",
    "* * 22-28 * 6"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    }
  ]
}
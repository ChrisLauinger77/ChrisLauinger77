{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>ChrisLauinger77/ChrisLauinger77//renovate-config/default"
  ],
  "packageRules": [
    {
      "description": "Paseo SDK is tied to the manifest's supported Paseo range; update together after verification",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@getpaseo/**"],
      "groupName": "Paseo SDK",
      "dependencyDashboardApproval": true
    },
    {
      "description": "React and React Native must match the Paseo app runtime",
      "matchManagers": ["npm"],
      "matchPackageNames": ["react", "react-native", "@types/react"],
      "groupName": "Paseo app runtime",
      "dependencyDashboardApproval": true
    },
    {
      "description": "Stay on the Node 22 line used by CI and validation",
      "matchDepNames": ["node", "@types/node"],
      "allowedVersions": "22.x"
    }
  ]
}

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>ChrisLauinger77/ChrisLauinger77//renovate-config/default"
  ],
  "packageRules": [
    {
      "description": "Keep unrelated npm updates independently reviewable",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "!@tauri-apps/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": null
    },
    {
      "description": "Keep unrelated Rust updates independently reviewable",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "!tauri",
        "!tauri-build"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": null
    },
    {
      "description": "Review Rust 0.x patch updates individually behind dashboard approval",
      "matchManagers": [
        "cargo"
      ],
      "matchCurrentVersion": "<1.0.0",
      "matchUpdateTypes": [
        "patch"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Review potentially breaking Rust 0.x minor updates individually",
      "matchManagers": [
        "cargo"
      ],
      "matchCurrentVersion": "<1.0.0",
      "matchUpdateTypes": [
        "minor"
      ],
      "groupName": null,
      "dependencyDashboardApproval": true
    },
    {
      "description": "Keep Tauri packages together and require dashboard approval",
      "matchPackageNames": [
        "@tauri-apps/**",
        "tauri",
        "tauri-build"
      ],
      "groupName": "Tauri",
      "dependencyDashboardApproval": true
    },
    {
      "description": "Review Rust toolchain action updates separately",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "dtolnay/rust-toolchain"
      ],
      "groupName": "Rust toolchain",
      "dependencyDashboardApproval": true
    },
    {
      "description": "Keep React packages together",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "groupName": "react"
    },
    {
      "description": "Vite and its React plugin must move together",
      "matchManagers": [
        "npm"
      ],
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "vite",
        "@vitejs/plugin-react"
      ],
      "groupName": "Vite toolchain"
    },
    {
      "description": "Node and jsdom runtime requirements must move together",
      "matchManagers": [
        "npm",
        "github-actions"
      ],
      "matchDatasources": [
        "npm",
        "node-version"
      ],
      "matchPackageNames": [
        "node",
        "jsdom"
      ],
      "groupName": "Node.js test runtime"
    },
    {
      "description": "Windows API crates move together; migrations require full CI, a packaged Windows artifact and notification/tray/Notification Center/activation smoke tests",
      "matchManagers": [
        "cargo"
      ],
      "matchDatasources": [
        "crate"
      ],
      "matchPackageNames": [
        "windows",
        "windows-core"
      ],
      "groupName": "Windows API crates"
    },
    {
      "description": "Keep windows-core below 0.100 until a matching windows crate is available; review future paired updates together",
      "matchManagers": [
        "cargo"
      ],
      "matchDatasources": [
        "crate"
      ],
      "matchPackageNames": [
        "windows-core"
      ],
      "allowedVersions": "<0.100.0"
    },
    {
      "description": "Keep GTK aligned with Tauri/Wry gtk-rs; defer breaking 0.x minor and major updates until stack-compatible, then require a Linux native build and graphical notification/tray/browser/lifecycle smoke tests",
      "matchManagers": [
        "cargo"
      ],
      "matchDatasources": [
        "crate"
      ],
      "matchPackageNames": [
        "gtk"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "enabled": false
    },
    {
      "description": "GIO generation changes follow Tauri/Wry gtk-rs compatibility",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "gio"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "enabled": false
    }
  ]
}
